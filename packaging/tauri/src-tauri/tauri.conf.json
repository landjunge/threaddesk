{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThreadDesk",
  "version": "0.1.1-rc.2",
  "identifier": "de.netzwerkpunkt.threaddesk.tauri",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "resources": {
      "../backend/dist/ThreadDeskServer": "bin/ThreadDeskServer"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}

