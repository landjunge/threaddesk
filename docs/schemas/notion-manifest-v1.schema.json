{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threaddesk.netzwerkpunkt.de/schemas/notion-manifest-v1.schema.json",
  "title": "ThreadDesk Notion bundle manifest v1",
  "type": "object",
  "required": [
    "format",
    "schema_version",
    "export_id",
    "created_at",
    "source_workspace_id",
    "roots",
    "counts",
    "files"
  ],
  "properties": {
    "format": {"const": "threaddesk-notion-bundle-v1"},
    "schema_version": {"const": 1},
    "export_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_workspace_id": {"type": "string", "minLength": 1},
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "counts": {
      "type": "object",
      "required": ["objects", "relations", "content", "attachments", "exclusions"],
      "properties": {
        "objects": {"type": "integer", "minimum": 0},
        "relations": {"type": "integer", "minimum": 0},
        "content": {"type": "integer", "minimum": 0},
        "attachments": {"type": "integer", "minimum": 0},
        "exclusions": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256", "size"],
        "properties": {
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
